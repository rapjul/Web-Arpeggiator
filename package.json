{
  "name": "web-arpeggiator",
  "version": "1.0.0",
  "description": "A browser-based musical arpeggiator application built with JavaScript, Tone.js, Tonal.js, and Tailwind CSS.",
  "type": "module",
  "scripts": {
    "postinstall": "rm -rf node_modules/.vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "preview:pwa": "bun run build && bun run preview",
    "format": "bunx biome format --write .",
    "format:check": "bunx biome format .",
    "test:unit": "vitest run tests/unit",
    "test:coverage": "vitest run --coverage tests/unit",
    "test:bun": "bun test tests/unit",
    "test:e2e": "bun run build && bun test --timeout 60000 tests/e2e",
    "test": "vitest run tests/unit",
    "test:all": "vitest run tests/unit && bun run test:e2e",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "tonal": "^6.4.2",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@tailwindcss/vite": "^4.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "agent-browser": "0.35.0",
    "bun-types": "^1.3.14",
    "happy-dom": "^20.12.0",
    "lint-staged": "^17.4.1",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.0.0",
    "typescript": "7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged"
  },
  "lint-staged": {
    "*.{html,css,js,ts,json}": "biome format --write --no-errors-on-unmatched"
  }
}
