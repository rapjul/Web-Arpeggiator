{
    "name": "web-arpeggiator",
    "version": "1.0.0",
    "description": "A browser-based musical arpeggiator application built with JavaScript, Tone.js, Tonal.js, and Tailwind CSS.",
    "type": "module",
    "scripts": {
        "postinstall": "rm -rf node_modules/.vite",
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "preview:pwa": "bun run build && bun run preview",
        "format": "bunx prettier --write .",
        "format:check": "bunx prettier --check .",
        "test:unit": "bun test tests/unit",
        "test:coverage": "bun test --coverage tests/unit",
        "test:e2e": "bun run build && bun test --timeout 60000 tests/e2e",
        "test": "bun run test:unit",
        "test:all": "bun run test:unit && bun run test:e2e"
    },
    "dependencies": {
        "@breezystack/lamejs": "^1.2.7",
        "tonal": "^6.4.2",
        "tone": "^14.8.49"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "agent-browser": "^0.27.1",
        "bun-types": "^1.3.14",
        "prettier": "^3.9.6",
        "tailwindcss": "^4.0.0",
        "vite": "^8.2.2",
        "vite-plugin-pwa": "^1.3.0"
    }
}
